# Builds the arbiter-scheduler binary. Build context is the repo root (see
# deploy/docker-compose.yml), since the binary needs the whole module to compile.
FROM golang:1.22-alpine AS builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -o /out/scheduler ./cmd/scheduler

FROM alpine:3.20

RUN apk add --no-cache ca-certificates

WORKDIR /app
COPY --from=builder /out/scheduler ./scheduler
COPY migrations ./migrations

EXPOSE 7000 8080

ENTRYPOINT ["./scheduler"]
