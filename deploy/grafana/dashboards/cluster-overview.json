{
  "uid": "arbiter-cluster",
  "title": "Arbiter Cluster Overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "tags": ["arbiter"],
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Is Leader (sum)",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(arbiter_is_leader)", "refId": "A" }],
      "fieldConfig": { "defaults": { "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Queue Depth",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [{ "expr": "max(arbiter_queue_depth)", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Tasks Running",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [{ "expr": "max(arbiter_tasks_running)", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Ready Nodes",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [{ "expr": "max(arbiter_nodes_total{status=\"ready\"})", "refId": "A" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Node CPU Utilization",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "arbiter_node_cpu_allocated_millicores / clamp_min(arbiter_node_cpu_capacity_millicores, 1)",
          "legendFormat": "{{hostname}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Node Memory Utilization",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "arbiter_node_memory_allocated_mb / clamp_min(arbiter_node_memory_capacity_mb, 1)",
          "legendFormat": "{{hostname}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Nodes by Status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "max by (status) (arbiter_nodes_total)", "legendFormat": "{{status}}", "refId": "A" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Queue Depth & Running Tasks",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "expr": "max(arbiter_queue_depth)", "legendFormat": "pending", "refId": "A" },
        { "expr": "max(arbiter_tasks_running)", "legendFormat": "running", "refId": "B" }
      ]
    }
  ]
}
